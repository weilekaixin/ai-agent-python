# Copy to secret.yaml, fill in values, then: kubectl apply -f k8s/secret.yaml
# DO NOT commit secret.yaml to version control.
apiVersion: v1
kind: Secret
metadata:
  name: ai-agent-secret
  namespace: ai-agent
type: Opaque
stringData:
  DATABASE_URL: "postgresql://aiagent:CHANGE_ME@postgres:5432/aiagent"
  REDIS_HOST: "redis"
  REDIS_PASSWORD: ""
  API_KEY: "CHANGE_ME"
  OPENAI_API_KEY: "sk-CHANGE_ME"
  JWT_SECRET: "CHANGE_ME_32_CHARS_MIN"
